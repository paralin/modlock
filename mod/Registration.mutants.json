[
  {
    "name": "Premature completion invokes a refused start callback before return",
    "replace": [
      [
        "FailureFrame == /\\ refusedPhase = \"scheduled\" /\\ refusedReturned",
        "FailureFrame == /\\ refusedPhase = \"scheduled\""
      ]
    ],
    "expect": "NoPrematureCompletion"
  },
  {
    "name": "Completion remains pending during its callback",
    "replace": [
      [
        "/\\ pending' = FALSE\n              /\\ completions'",
        "/\\ pending' = pending\n              /\\ completions'"
      ]
    ],
    "expect": "AtMostOnce"
  },
  {
    "name": "Slot-only identity lets a kept Player address the replacement connection",
    "replace": [["/\\ tenure' = tenure + 1", "/\\ tenure' = tenure"]],
    "expect": "SavedConnection"
  },
  {
    "name": "Subscriptions are computed before the Start callbacks",
    "replace": [
      [
        "/\\ handlers' = Append(handlers, 2) /\\ subscription' = TRUE",
        "/\\ handlers' = Append(handlers, 2) /\\ subscription' = FALSE"
      ]
    ],
    "expect": "SubscriptionsAfterStart"
  },
  {
    "name": "Command lookup is delayed until the frame",
    "replace": [
      [
        "[kind |-> \"command\", id |-> captured]",
        "[kind |-> \"command\", id |-> command]"
      ]
    ],
    "expect": "CallbackOrder"
  },
  {
    "name": "Deferred lists are captured at enqueue",
    "replace": [
      [
        "/\\ snapshot' = handlers /\\ cursor' = 1",
        "/\\ snapshot' = <<1, 2>> /\\ cursor' = 1"
      ]
    ],
    "expect": "CallbackOrder"
  },
  {
    "name": "Range grows when a callback registers another handler",
    "replace": [
      [
        "/\\ handlers' = Append(handlers, 4) /\\ duringAdded' = TRUE",
        "/\\ handlers' = Append(handlers, 4) /\\ duringAdded' = TRUE /\\ snapshot' = Append(snapshot, 4)"
      ],
      [
        "/\\ UNCHANGED <<snapshot, cursor, timersDone, delivered, expected, queue,",
        "/\\ UNCHANGED <<cursor, timersDone, delivered, expected, queue,"
      ]
    ],
    "expect": "CallbackOrder"
  },
  {
    "name": "Frame handlers overtake a deferred UI callback",
    "replace": [
      [
        "Frame == /\\ queue = \"frame\" /\\ timersDone /\\ BeginList(\"frame\")",
        "Frame == /\\ queue = \"frame\" /\\ BeginList(\"frame\")"
      ],
      ["EndList(\"chat\", \"ui\")", "EndList(\"chat\", \"frame\")"]
    ],
    "expect": "TimersBeforeFrames"
  }
]
