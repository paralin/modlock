	-- remove takes the pickup out of the world. It reports false when a
	-- player had collected it.
	remove: (self: Pickup) -> boolean,
}
local Pickup = {}
Pickup.__index = Pickup

-- new returns the Pickup with entity.
function Pickup.new(entity: number): Pickup
	return setmetatable({ entity = entity }, Pickup) :: any
end

-- present reports whether the pickup still lies in the world,
-- uncollected.
function Pickup.present(self: Pickup): boolean
	local response = call("PickupPresent", "PickupRequest", { pickup = self }, "AliveResponse")
	if response == nil then
