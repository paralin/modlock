-- log writes one line to the server log under the mod's name.
function modlock.log(message: string): boolean
	return call("Log", "LogRequest", { message = message }) ~= nil
end

-- serverCommand runs one line at the server console, as if typed there. A
-- line that sets a variable may set a development-only or cheat-protected
-- one. A line that reaches the engine's controls for files, logging, the
-- network or the process, or stores a command to run later, is refused with
-- the name of the command.
function modlock.serverCommand(command: string): boolean
	return call("ServerCommand", "ServerCommandRequest", { command = command }) ~= nil
end

-- precache loads heroes and resources with the next world. Call it during
-- start, before the first world loads; a call after that, such as from a
-- reload, prepares only the world after the next map change. Name every
-- hero whose abilities ReplaceAbility gives, with their particles.
function modlock.precache(options: PrecacheOptions): boolean
	return call("Precache", "PrecacheOptions", options) ~= nil
end

-- readFile reads one of the mod's files: the host's copy, which the mod
-- wrote or the server's operator placed, else the one the mod ships under
-- data/. A file in neither reads as unset. Names that leave the mod's
-- directories are refused.
function modlock.readFile(name: string): string?
	local response = call("ReadFile", "ReadFileRequest", { name = name }, "ReadFileResponse")
	if response == nil then
		return nil
	end
	return response.text
end

-- writeFile replaces one of the mod's files in the host's copy, which
-- outlives a restart and an update of the mod; the files the mod ships stay
-- as they are. The write is whole or not at all, and the host refuses one
-- past its quota of 4 MiB per mod. A host that keeps no files refuses every
-- write.
function modlock.writeFile(name: string, text: string): boolean
	return call("WriteFile", "WriteFileRequest", { name = name, text = text }) ~= nil
end

-- holdReload keeps the running build through a reload while held is true,
-- such as while a player is partway through something a new build would
-- lose. A reload that arrives meanwhile waits, and the newest one applies
-- on the first frame after the mod releases the hold. A new build starts
-- without a hold.
function modlock.holdReload(held: boolean): boolean
	return call("HoldReload", "HoldReloadRequest", { held = held }) ~= nil
end

-- handoff replaces the handoff state for the game: what the running build
-- hands the next build when the mod reloads, such as which round it plays.
-- It lasts only through a reload of the mod in the same game, such as an
-- update, whose new build reads it back with HandedOff. The host holds it
-- in memory and never writes it to disk, so it ends when the mod stops or
-- the server restarts. The host refuses state past 64 KiB.
function modlock.handoff(text: string): boolean
	return call("Handoff", "HandoffRequest", { text = text }) ~= nil
end

-- handedOff returns the game's handoff state, or empty.
function modlock.handedOff(): string?
	local response = call("HandedOff", "Empty", {}, "HandedOffResponse")
	if response == nil then
		return nil
	end
	return response.text
end

-- heroBuild reads a hero's recommended build from the host's game data:
-- its categories of items in buying order. Items the game does not define
-- are left out, so every item returned is one GiveItem accepts. A hero
-- without a build answers with no categories. The call needs a loaded
-- world.
function modlock.heroBuild(hero: string): { BuildCategory }
	local response = call("HeroBuild", "HeroBuildRequest", { hero = hero }, "HeroBuildResponse")
	if response == nil then
		return {}
	end
	return response.categories
end

-- readField reads one schema field of a live entity, such as the int32
-- m_iHealth of CBaseEntity. The host finds the field by name, so it
-- survives game updates that move it, and refuses an entity that is not of
-- the named class or a subclass. The match's state, such as the gold of each
-- team or the winning team, is a field of CCitadelGameRules, which the
-- citadel_gamerules entity reads. The parts of an entity's model that its
-- body component holds read through the entity too: CGameSceneNode, and for
-- a model entity CSkeletonInstance and CModelState, such as the uint64
-- m_MeshGroupMask of CModelState that chooses which mesh groups draw.
function modlock.readField(entity: number, className: string, field: string, type: FieldType): FieldValue?
	local response = call("ReadField", "ReadFieldRequest", { entity = entity, className = className, field = field, type = type }, "FieldResponse")
	if response == nil then
		return nil
	end
	return response.value
end

-- readModifierField reads one schema field of a modifier the entity holds,
-- such as the int32 m_nCameraLevel of CCitadel_Modifier_OrbitCamera on a
-- pawn holding modifier_citadel_orbit_camera. The answer holds no value
-- while the entity lacks the modifier. The host cannot check the modifier's
-- class, so a wrong class reads the wrong bytes, though never past readable
-- memory.
function modlock.readModifierField(entity: number, modifier: string, className: string, field: string, type: FieldType): FieldValue?
	local response = call("ReadModifierField", "ReadModifierFieldRequest", { entity = entity, modifier = modifier, className = className, field = field, type = type }, "FieldResponse")
	if response == nil then
		return nil
	end
	return response.value
end

-- writeField writes one schema field of a live entity and sends the change
-- to the players. The value takes the form ReadField returns for the type;
-- text fields cannot be written. A write to the match's state sends all of
-- it, so players already in the match see the change, and a write to a
-- model part, as ReadField names them, sends the entity.
function modlock.writeField(entity: number, className: string, field: string, type: FieldType, value: FieldValue): boolean
	return call("WriteField", "WriteFieldRequest", { entity = entity, className = className, field = field, type = type, value = value }) ~= nil
end

-- readFieldList reads a field that holds a list, such as the m_vecBannedHeroes
-- of CCitadelGameRules. The type is the type of one element: a number, a
-- handle, a boolean or a vector. A list of structures cannot be read.
function modlock.readFieldList(entity: number, className: string, field: string, type: FieldType): { FieldValue }
	local response = call("ReadFieldList", "ReadFieldRequest", { entity = entity, className = className, field = field, type = type }, "FieldListResponse")
	if response == nil then
		return {}
	end
	return response.values
end

-- writeFieldList replaces the elements of a list field and sends the change
-- to the players, growing the list when it holds fewer elements than the
-- new ones.
function modlock.writeFieldList(entity: number, className: string, field: string, type: FieldType, values: { FieldValue }?): boolean
	return call("WriteFieldList", "WriteFieldListRequest", { entity = entity, className = className, field = field, type = type, values = values }) ~= nil
end

-- entityClass returns a live entity's schema class, such as
-- CCitadelPlayerPawn, whose fields ReadField reads, and its designer name.
function modlock.entityClass(entity: number): EntityClassName?
	local response = call("EntityClass", "EntityRequest", { entity = entity }, "EntityClassResponse")
	if response == nil then
		return nil
	end
	return response.name
end

-- entityPosition returns where a live entity stands, its absolute origin
-- and angles, as MoveEntity places it, and its velocity. Any entity with a
-- place in the world has one, such as one of the map's boxes.
function modlock.entityPosition(entity: number): EntityPlacement?
	local response = call("EntityPosition", "EntityRequest", { entity = entity }, "EntityPositionResponse")
	if response == nil then
		return nil
	end
	return response.placement
end

-- modifierState reports whether an entity has a modifier state, such as
-- MODIFIER_STATE_PARRY_ACTIVE.
function modlock.modifierState(entity: number, state: string): boolean
	local response = call("ModifierState", "ModifierStateRequest", { entity = entity, state = state }, "ActiveResponse")
	if response == nil then
		return false
	end
	return response.active
end

-- holdModifierState holds a modifier state, such as
-- MODIFIER_STATE_FRIENDLY_FIRE_ENABLED, on an entity while the mod runs, or
-- releases the hold. The hold ends with the entity.
function modlock.holdModifierState(entity: number, state: string, active: boolean?): boolean
	return call("HoldModifierState", "HoldModifierStateRequest", { entity = entity, state = state, active = active }) ~= nil
end

-- setFreeForAll turns free-for-all on or off for the running mod, over the
-- Manifest's free_for_all default. While on, the host seats each new player
-- on the smaller team with no team screen, holds friendly fire on every
-- hero, makes teammates enemies to abilities, projectiles and target
-- checks, and ignores changeteam commands. The stock hero picker does not
-- open for a seated player, so the mod gives each seated player whose pawn
-- has hero 0 a hero with SelectHero. Turning it off releases the friendly
-- fire holds and restores stock team relations; players keep their teams.
-- Clients still draw teammates as allies.
function modlock.setFreeForAll(enabled: boolean): boolean
	return call("SetFreeForAll", "SetFreeForAllRequest", { enabled = enabled }) ~= nil
end

-- setTeamSeating turns team seating on or off for the running mod. While
-- on, the host seats each player who joins with no team on the smaller
-- team with no team screen; friendly fire and changeteam stay as the game
-- has them. The stock hero picker does not open for a seated player, so
-- the mod gives each seated player whose pawn has hero 0 a hero with
-- SelectHero. Free-for-all seats players this
-- way whatever this says. Turning it off leaves players on their teams.
function modlock.setTeamSeating(enabled: boolean): boolean
	return call("SetTeamSeating", "SetTeamSeatingRequest", { enabled = enabled }) ~= nil
end

-- createModel places a model in the world, solid when the options ask.
-- The world removes it when the world ends; stopping the mod removes it
-- too.
function modlock.createModel(options: ModelOptions): WorldObject?
	local response = call("CreateModel", "ModelOptions", options, "ObjectResponse")
	if response == nil then
		return nil
	end
	return response.object
end

-- createText places text that floats in the world.
function modlock.createText(options: TextOptions): WorldObject?
	local response = call("CreateText", "TextOptions", options, "ObjectResponse")
	if response == nil then
		return nil
	end
	return response.object
end

-- createParticle starts a particle effect. Removing the object stops it
-- and lets its end cap play out; moving it moves the effect.
function modlock.createParticle(options: ParticleOptions): WorldObject?
	local response = call("CreateParticle", "ParticleOptions", options, "ObjectResponse")
	if response == nil then
		return nil
	end
	return response.object
end

-- createFog fills a box with tinted fog whose density fades across the
-- box's boundary. Removing the object clears it; moving it moves the box.
function modlock.createFog(options: FogOptions): WorldObject?
	local response = call("CreateFog", "FogOptions", options, "ObjectResponse")
	if response == nil then
		return nil
	end
	return response.object
end

-- addBot adds a bot player and returns it. The bot leaves when the world
-- ends or the mod stops.
function modlock.addBot(options: BotOptions): Player?
	local response = call("AddBot", "BotOptions", options, "BotResponse")
	if response == nil then
		return nil
	end
	return response.player
end

-- blockInput withholds buttons from every player's hero until called
-- again. Stopping the mod releases them.
function modlock.blockInput(buttons: number): boolean
	return call("BlockInput", "InputRequest", { buttons = buttons }) ~= nil
end

-- watchInput replaces the buttons whose presses and releases arrive as
-- Input events. Watching does not withhold a press; block it with
-- BlockInput.
function modlock.watchInput(buttons: number): boolean
	return call("WatchInput", "InputRequest", { buttons = buttons }) ~= nil
end

-- remapInput makes the from buttons act as the to buttons for every
-- player's hero until called again; from reads as up. With repeat, a held
-- from button uses the to ability again as soon as it is ready. A zero from
-- stops remapping, and stopping the mod does too. BlockInput applies after
-- the remap.
function modlock.remapInput(from: number, to: number, repeat_: boolean?): boolean
	return call("RemapInput", "RemapInputRequest", { from = from, to = to, ["repeat"] = repeat_ }) ~= nil
end

-- callService calls method of a service the host provides outside Modlock,
-- such as a game mode's match, and returns the service's answer. The
-- service defines the payload's encoding.
function modlock.callService(service: string, method: string, payload: string): string?
	local response = call("CallService", "ServiceCall", { service = service, method = method, payload = payload }, "ServiceReply")
	if response == nil then
		return nil
	end
	return response.payload
end

-- createEntity creates any entity the server knows by its designer name,
-- such as npc_trooper_boss or prop_dynamic, with spawn key values and fields
-- written before it spawns. The world removes it when the world ends;
-- stopping the mod removes it too. It refuses an ability, item or weapon,
-- which only a hero holds: GiveItem and ReplaceAbility give one.
function modlock.createEntity(options: EntityOptions): number?
	local response = call("CreateEntity", "EntityOptions", options, "EntityResponse")
	if response == nil then
		return nil
	end
	return response.entity
end

-- fireInput sends an input to a live entity, as a map's output would, such
-- as Skin with the integer 1. The value must have the type the input reads.
-- It reports false once the entity is gone.
function modlock.fireInput(entity: number, input: string, value: EntityValue?, activator: number?): boolean
	local response = call("FireInput", "FireInputRequest", { entity = entity, input = input, value = value, activator = activator }, "AliveResponse")
	if response == nil then
		return false
	end
	return response.alive
end

-- removeEntity takes an entity the mod created out of the world without
-- rewards. It reports false when the entity was already gone.
function modlock.removeEntity(entity: number): boolean
	local response = call("RemoveEntity", "EntityRequest", { entity = entity }, "AliveResponse")
	if response == nil then
		return false
	end
	return response.alive
end

-- showEntityOnlyTo sends an entity the mod created only to the players with
-- the listed server slots; every other client drops it, or never receives
-- it when the call follows its creation in the same frame. With no players
-- no client receives it. The list replaces any earlier one. A player who
-- leaves is taken off every list, so whoever joins in their slot does not
-- receive the entity. The rule holds for an entity created with
-- TransmitAlways too, but not for entities parented to it, which need their
-- own call. Removing the entity, the world ending or the mod stopping drops
-- the rule.
function modlock.showEntityOnlyTo(entity: number, players: { number }?): boolean
	return call("ShowEntityOnlyTo", "ShowEntityOnlyToRequest", { entity = entity, players = players }) ~= nil
end

-- showEntityToAll sends an entity the mod created to every player the game
-- would send it to again, undoing ShowEntityOnlyTo.
function modlock.showEntityToAll(entity: number): boolean
	return call("ShowEntityToAll", "EntityRequest", { entity = entity }) ~= nil
end

-- spawnNpc adds a unit that is not a player, such as a trooper, as
-- CreateEntity does, then sets its health and lane. It thinks from the next
-- frame. The world removes it when the world ends; stopping
-- the mod removes it too.
function modlock.spawnNpc(options: NpcOptions): Npc?
	local response = call("SpawnNpc", "NpcOptions", options, "NpcResponse")
	if response == nil then
		return nil
	end
	return response.npc
end

-- createPickup places an urn, which a hero carries once collected, or a
-- movement buff. Stopping the mod removes it.
function modlock.createPickup(kind: PickupKind, position: Vector): Pickup?
	local response = call("CreatePickup", "CreatePickupRequest", { kind = kind, position = position }, "PickupResponse")
	if response == nil then
		return nil
	end
	return response.pickup
end

-- findEntities returns the handle of every live entity of a class, such as
-- zip_line_node.
function modlock.findEntities(className: string): { number }
	local response = call("FindEntities", "FindEntitiesRequest", { className = className }, "EntitiesResponse")
	if response == nil then
		return {}
	end
	return response.entities
end

-- removeEntities removes every entity of a class, such as npc_trooper,
-- without rewards, and returns how many it removed.
function modlock.removeEntities(className: string): number?
	local response = call("RemoveEntities", "RemoveEntitiesRequest", { className = className }, "CountResponse")
	if response == nil then
		return nil
	end
	return response.count
end

-- clearMap removes the map's own units and objectives, such as troopers,
-- guardians and walkers, so a mode can use the map as an arena.
function modlock.clearMap(): boolean
	return call("ClearMap", "Empty", {}) ~= nil
end

-- damage deals a hit as the game would. The mod's Damage events do not
-- include its own hits.
function modlock.damage(options: HitOptions): boolean
	return call("Damage", "HitOptions", options) ~= nil
end

-- trace returns where a line first hits something, or nothing when it hits
-- nothing or the world's collision is not ready.
function modlock.trace(options: TraceOptions): TraceHit?
	local response = call("Trace", "TraceOptions", options, "TraceResponse")
	if response == nil then
		return nil
	end
	return response.hit
end

-- restoreNpcs replaces the map's lane units and objectives with targets
-- over the next frames. Units of these classes not in the list are
-- removed, structures that match are kept, and moving units are spawned
-- again in place. An NpcsRestored event reports when every target stands
-- as its own unit, or why not. A new call replaces the running one.
function modlock.restoreNpcs(npcs: { NpcTarget }?): boolean
	return call("RestoreNpcs", "RestoreNpcsRequest", { npcs = npcs }) ~= nil
end

-- pause stops or resumes the game clock, as the pause command would.
-- Stopping the mod resumes it.
function modlock.pause(paused: boolean): boolean
	return call("Pause", "PauseRequest", { paused = paused }) ~= nil
end

-- matchClock returns the match time in seconds that the scoreboard shows.
function modlock.matchClock(): number?
	local response = call("MatchClock", "Empty", {}, "MatchClockResponse")
	if response == nil then
		return nil
	end
	return response.seconds
end

-- holdMatchClock keeps the match time at seconds every frame until called
-- again; omitted seconds let it run.
function modlock.holdMatchClock(seconds: number?): boolean
	return call("HoldMatchClock", "HoldMatchClockRequest", { seconds = seconds }) ~= nil
end

-- rift reads the Rift objective's state.
function modlock.rift(): RiftState?
	local response = call("Rift", "Empty", {}, "RiftResponse")
	if response == nil then
		return nil
	end
	return response.state
end

-- startRift opens the Rift objective at position now.
function modlock.startRift(position: Vector): boolean
	return call("StartRift", "StartRiftRequest", { position = position }) ~= nil
end

-- moveEntity places any entity, such as a projectile, and replaces its
-- facing and motion when given. Without a position it leaves the entity
-- where it is, so a velocity alone steers a body the physics simulates, such
-- as a prop_physics, which carries the motion on against the world.
function modlock.moveEntity(entity: number, position: Vector?, facing: Angles?, velocity: Vector?): boolean
	return call("MoveEntity", "MoveEntityRequest", { entity = entity, position = position, facing = facing, velocity = velocity }) ~= nil
end

-- pushEntity adds a velocity and an angular velocity to any entity. On a
-- body the physics simulates, such as a prop_physics, it acts like an
-- impulse that the simulation carries on.
function modlock.pushEntity(entity: number, velocity: Vector, spin: Vector?): boolean
	return call("PushEntity", "PushEntityRequest", { entity = entity, velocity = velocity, spin = spin }) ~= nil
end

-- emitSound plays one game sound on any entity, such as a projectile.
function modlock.emitSound(entity: number, sound: string): boolean
	return call("EmitSound", "EmitSoundRequest", { entity = entity, sound = sound }) ~= nil
end

-- watchProjectiles reports the projectiles with these designer names, such
-- as rocket_launcher_rocket_projectile, in Launch and Impact events. A new
-- call replaces the list; an empty list stops watching.
function modlock.watchProjectiles(options: ProjectileOptions): boolean
	return call("WatchProjectiles", "ProjectileOptions", options) ~= nil
end

-- ModHandlers handles the events the game delivers to the mod.
export type ModHandlers = {
	-- start begins the mod's active lifetime, once, before any other event.
	start: (event: StartEvent) -> StartResult,
	-- frame runs once per server frame while the mod asked for frames.
	frame: (event: FrameEvent) -> (),
	-- command offers one command a player typed.
	command: (event: CommandEvent) -> CommandResult,
	-- chat reports each chat line the server accepted from a player the mod
	-- serves, while the mod asked for chat, before the line's command.
	chat: (event: ChatEvent) -> (),
	-- world follows each world load, and start when a world has already
	-- loaded. Objects and bots from an earlier world are gone by then.
	world: (event: WorldEvent) -> (),
	-- uiPress reports a press on a button in a player's interface.
	uiPress: (event: UiPressEvent) -> (),
	-- uiInput reports a change to an input in a player's interface.
	uiInput: (event: UiInputEvent) -> (),
	-- serve calls a service the mod serves from the host.
	serve: (event: ServiceCall) -> ServiceReply,
	-- damage offers one hit before the game applies it, while the mod asked
	-- for damage. The mod's answer may block the hit or change its amount.
	damage: (event: DamageEvent) -> DamageResult,
	-- damaged reports one hit the game applied, while the mod asked for
	-- damage reports. Hits arrive before the next frame.
	damaged: (event: DamagedEvent) -> (),
	-- input reports one player's presses of watched buttons, before the next
	-- frame. A block in place still withholds them from the hero.
	input: (event: InputEvent) -> (),
	-- restored ends one RestoreHero, before the next frame.
	restored: (event: RestoredEvent) -> (),
	-- npcsRestored ends one RestoreNpcs, before the next frame.
	npcsRestored: (event: NpcsRestoredEvent) -> (),
	-- launch reports a watched projectile's first frame, before the next frame.
	launch: (event: LaunchEvent) -> (),
	-- impact reports a watched projectile striking something, inside the
	-- game's impact and after its own explosion. The mod's calls apply before
	-- the game continues.
	impact: (event: ImpactEvent) -> (),
	-- landed reports a hero landing under the manifest's QuakeWorld movement,
	-- before the next frame.
	landed: (event: LandedEvent) -> (),
	-- settingChanged reports a player's setting that changed outside the mod,
	-- such as on the player's profile. A mod's own SetPlayerSetting reports
	-- nothing.
	settingChanged: (event: SettingChangedEvent) -> (),
	-- playersChanged reports the occupied player slots before the first event
	-- after Start, and again before the next event whenever a player joins,
	-- finishes joining or leaves, so a mod lists players without a call.
	playersChanged: (event: PlayersChangedEvent) -> (),
}

-- events holds each Mod method's request, response and handler.
local events: { [string]: { request: string, response: string, handler: string } } = {
	Start = { request = "StartEvent", response = "StartResult", handler = "start" },
	Frame = { request = "FrameEvent", response = "Empty", handler = "frame" },
	Command = { request = "CommandEvent", response = "CommandResult", handler = "command" },
	Chat = { request = "ChatEvent", response = "Empty", handler = "chat" },
	World = { request = "WorldEvent", response = "Empty", handler = "world" },
	UiPress = { request = "UiPressEvent", response = "Empty", handler = "uiPress" },
	UiInput = { request = "UiInputEvent", response = "Empty", handler = "uiInput" },
	Serve = { request = "ServiceCall", response = "ServiceReply", handler = "serve" },
	Damage = { request = "DamageEvent", response = "DamageResult", handler = "damage" },
	Damaged = { request = "DamagedEvent", response = "Empty", handler = "damaged" },
	Input = { request = "InputEvent", response = "Empty", handler = "input" },
	Restored = { request = "RestoredEvent", response = "Empty", handler = "restored" },
	NpcsRestored = { request = "NpcsRestoredEvent", response = "Empty", handler = "npcsRestored" },
	Launch = { request = "LaunchEvent", response = "Empty", handler = "launch" },
	Impact = { request = "ImpactEvent", response = "Empty", handler = "impact" },
	Landed = { request = "LandedEvent", response = "Empty", handler = "landed" },
	SettingChanged = { request = "SettingChangedEvent", response = "Empty", handler = "settingChanged" },
	PlayersChanged = { request = "PlayersChangedEvent", response = "Empty", handler = "playersChanged" },
}

-- serveMod runs the encoded Call in bytes on handlers and returns the encoded
-- Reply. A handler that errors answers with its error and traceback.
local function serveMod(handlers: ModHandlers, bytes: string): string
	local request = wire.decode(schema, "Call", bytes)
	local event = events[request.method]
	if event == nil then
		return wire.encode(schema, "Reply", { error = "the mod has no method " .. request.method })
	end
	local handler = (handlers :: any)[event.handler]
	local ok, response = xpcall(function()
		local answer = handler(wire.decode(schema, event.request, request.request))
		return wire.encode(schema, event.response, answer or {})
	end, function(message: any): string
		return debug.traceback(tostring(message), 2)
	end)
	if not ok then
		return wire.encode(schema, "Reply", { error = tostring(response) })
	end
	return wire.encode(schema, "Reply", { response = response })
end

-- The modlock library writes Modlock mods in Luau. A mod registers its
-- handlers when its main module runs; modlock-host runs the mod in a sandbox
-- inside the game server and calls the handlers on the server's frame
-- thread, one at a time.
--
--   local modlock = require("@modlock")
--
--   modlock.command("hello", function(player)
--   	player:chat("Hello from Luau!")
--   end)
--
-- Build it with modlock build.
--
-- The calls into the game and their types above are generated from the
-- schema. A call that fails logs why in the server log and returns false or
-- nil, so a mod can retry on a later frame instead of stopping. print writes
-- to the server log.

-- Buttons names input bits for blockInput, watchInput and Player.press.
modlock.Buttons = {
	-- attack is the primary fire button.
	attack = 1,
	-- jump is the jump key, Space by default (IN_MANTLE). Blocking it stops the
	-- native jump and mantle; the jumping client still predicts the jump and is
	-- corrected.
	jump = 2 ^ 48,
	-- crouch is the crouch key, Ctrl by default.
	crouch = 2 ^ 2,
	-- dash is the dash key, Shift by default.
	dash = 2 ^ 16,
	-- use is the interact key.
	use = 2 ^ 5,
	-- altFire is the zoom and alternate fire button, right mouse by default.
	altFire = 2 ^ 11,
	-- reload is the reload key.
	reload = 2 ^ 13,
	-- melee is the light melee key, Q by default.
	melee = 2 ^ 32,
	-- ability1 to ability3 are the hero's first three ability keys.
	ability1 = 2 ^ 33,
	ability2 = 2 ^ 34,
	ability3 = 2 ^ 35,
	-- ultimate is the hero's ultimate ability key, the fourth.
	ultimate = 2 ^ 36,
	-- parry is the melee parry button.
	parry = 2 ^ 42,
}

-- Layers names collision layers for trace, as bits.
modlock.Layers = {
	-- solid is the world and solid objects.
	solid = 1,
	-- hitbox is the hit boxes of heroes and units.
	hitbox = 2 ^ 1,
	-- trigger is invisible volumes that react to touch.
	trigger = 2 ^ 2,
	-- playerClip is walls that only stop heroes.
	playerClip = 2 ^ 4,
	-- player is player-controlled heroes.
	player = 2 ^ 18,
	-- npc is units that are not players.
	npc = 2 ^ 19,
	-- staticLevel is the map's built geometry, foliage included.
	staticLevel = 2 ^ 30,
	-- hero, trooper and building are those units' bodies.
	hero = 2 ^ 37,
	trooper = 2 ^ 38,
	building = 2 ^ 40,
}

-- has reports whether bits, a sum of Buttons or Layers bits, holds bit.
-- bit32 reaches only the low 32 bits, and these bits go up to 2^42.
function modlock.has(bits: number, bit: number): boolean
	return bits // bit % 2 == 1
end

-- setOrbitCamera gives the player's hero the hideout's orbit camera, zoomed
-- with the wheel, or returns the normal camera. The hideout HUD replaces the
-- game HUD while it is on. It returns false when the player has no hero or a
-- call fails.
--
-- The pawn's networked m_bInHideoutZone moves its client to the hideout view,
-- and the wheel zooms only while the pawn holds MODIFIER_STATE_HIDEOUT_ZONE,
-- since the server ignores orbit_camera_in and orbit_camera_out without it.
function modlock.setOrbitCamera(player: Player, enabled: boolean): boolean
	local pawn = player:pawn()
	if pawn == nil or pawn.entity == 0 then
		return false
	end
	local flag = modlock.writeField(pawn.entity, "CCitadelPlayerPawn", "m_bInHideoutZone", "bool", enabled)
	local zoom = modlock.holdModifierState(pawn.entity, "MODIFIER_STATE_HIDEOUT_ZONE", enabled)
	return flag and zoom
end

-- Service answers the host's calls to one service the mod serves: the
-- method's name and payload in, the answer out. An error becomes the call's
-- error.
export type Service = (method: string, payload: string) -> string

-- commands maps each registered command name to its handler.
local commands: { [string]: (player: Player, args: string) -> () } = {}

-- services maps each service the mod serves to its handler.
local services: { [string]: Service } = {}

-- starts to settingChanges hold each event's handlers, which run in
-- registration order.
local starts: { (args: { string }) -> () } = {}
local frames: { (frame: FrameEvent) -> () } = {}
local chats: { (line: ChatEvent) -> () } = {}
local worlds: { (map: string) -> () } = {}
local inputs: { (player: Player, pressed: number, released: number) -> () } = {}
local restoreds: { (player: Player, error: string?) -> () } = {}
local npcsRestoreds: { (error: string?) -> () } = {}
local damages: { (hit: DamageEvent) -> DamageResult? } = {}
local damageds: { (hit: DamagedEvent) -> () } = {}
local launches: { (projectile: LaunchEvent) -> () } = {}
local impacts: { (impact: ImpactEvent) -> () } = {}
local landeds: { (landing: LandedEvent) -> () } = {}
local settingChanges: { (player: Player, key: string, value: string) -> () } = {}

-- roster is the player list the host last reported, or nil before one.
local roster: { Connection }? = nil

-- players lists the occupied player slots in slot order. It answers from the
-- roster the host last reported, and asks the host until a report arrives.
function modlock.players(): { Connection }
	if roster ~= nil then
		return table.clone(roster)
	end
	local response = call("Players", "Empty", {}, "PlayersResponse")
	if response == nil then
		return {}
	end
	return response.players
end

-- serve answers the host's calls to service with handler, replacing its
-- earlier handler.
function modlock.serve(service: string, handler: Service)
	services[service] = handler
end

-- command calls handler when a player types /name in chat or their client
-- sends the console command name to the server. The handler runs with the
-- next server frame, before the frame handlers, and receives the text after
-- the name, trimmed of surrounding spaces. Registering a name again replaces
-- its handler.
function modlock.command(name: string, handler: (player: Player, args: string) -> ())
	commands[name] = handler
end

-- onStart calls handler once when the server starts the mod, with the
-- arguments that follow -- on the modlock-host command line.
function modlock.onStart(handler: (args: { string }) -> ())
	table.insert(starts, handler)
end

-- onFrame calls handler once per server frame.
function modlock.onFrame(handler: (frame: FrameEvent) -> ())
	table.insert(frames, handler)
end

-- Timer is one scheduled callback.
export type Timer = {
	-- finished reports whether the timer ran its last time or was cancelled.
	finished: boolean,
	-- cancel stops the timer; it does nothing once the timer is finished.
	cancel: (self: Timer) -> (),
}

-- Entry is a Timer the clock keeps until it finishes.
type Entry = Timer & {
	id: number,
	-- at is the game time the entry next runs, unset until the clock is known.
	at: number?,
	delay: number,
	-- run returns the seconds before the entry's next run, or nil after its
	-- last.
	run: () -> number?,
}

local timerMethods = {}
timerMethods.__index = timerMethods

function timerMethods.cancel(self: Entry)
	self.finished = true
end

-- now is the game time of the latest frame, unset before the first.
local now: number? = nil
local entries: { Entry } = {}
local lastTimer = 0

-- schedule adds a timer whose first run is delay seconds away.
local function schedule(delay: number, run: () -> number?): Timer
	lastTimer += 1
	local entry = setmetatable({
		finished = false,
		id = lastTimer,
		at = if now then now + delay else nil,
		delay = delay,
		run = run,
	}, timerMethods) :: any
	table.insert(entries, entry)
	return entry
end

-- after runs fn once, seconds from now. Time is the game's, so a paused game
-- holds its timers. A tick is 1/64 second.
function modlock.after(seconds: number, fn: () -> ()): Timer
	return schedule(seconds, function()
		fn()
		return nil
	end)
end

-- every runs fn each seconds, keeping its cadence through a late frame.
function modlock.every(seconds: number, fn: () -> ()): Timer
	return schedule(seconds, function()
		fn()
		return seconds
	end)
end

-- sequence calls fn on the next frame with the number of times it has run,
-- starting at 1. fn returns the seconds to wait before it runs again, or
-- nothing to end the sequence.
function modlock.sequence(fn: (run: number) -> number?): Timer
	local runs = 0
	return schedule(0, function()
		runs += 1
		return fn(runs)
	end)
end

-- advanceTimers moves the clock to a frame and runs the timers that came due,
-- at most once each and in the order they came due. A callback that errors ends
-- only its own timer.
local function advanceTimers(seconds: number)
	now = seconds

	-- Start the timers made before the clock was known, then take the due ones.
	-- Timers a callback makes wait for the next frame.
	local due: { Entry } = {}
	for _, entry in entries do
		if entry.at == nil then
			entry.at = seconds + entry.delay
		end
		if not entry.finished and (entry.at :: number) <= seconds then
			table.insert(due, entry)
		end
	end
	table.sort(due, function(a: Entry, b: Entry)
		if a.at ~= b.at then
			return (a.at :: number) < (b.at :: number)
		end
		return a.id < b.id
	end)

	for _, entry in due do
		if entry.finished then
			continue
		end
		local ok, wait = pcall(entry.run)
		if not ok then
			entry.finished = true
			modlock.log("timer failed: " .. tostring(wait))
		elseif wait == nil then
			entry.finished = true
		else
			local delay = wait :: number
			local next = (entry.at :: number) + delay
			entry.at = if next > seconds then next else seconds + delay
		end
	end

	local live: { Entry } = {}
	for _, entry in entries do
		if not entry.finished then
			table.insert(live, entry)
		end
	end
	entries = live
end

-- onWorld calls handler with the map's name each time a world loads, and at
-- start when one already has. Objects and bots from an earlier world are
-- gone by then.
function modlock.onWorld(handler: (map: string) -> ())
	table.insert(worlds, handler)
end

-- onInput calls handler with the watched buttons a player pressed and
-- released, as Buttons bits, before the next frame. A button is held from
-- its press until its release.
function modlock.onInput(handler: (player: Player, pressed: number, released: number) -> ())
	table.insert(inputs, handler)
end

-- onRestored calls handler when a player's Player.restoreHero ends: error is
-- nil once the target held for a second, or says why it did not.
function modlock.onRestored(handler: (player: Player, error: string?) -> ())
	table.insert(restoreds, handler)
end

-- onNpcsRestored calls handler when restoreNpcs ends: error is nil once the
-- map holds every target, or says why it does not.
function modlock.onNpcsRestored(handler: (error: string?) -> ())
	table.insert(npcsRestoreds, handler)
end

-- onDamage calls handler before each hit lands, so it can block the hit or
-- change its damage. Later handlers see the earlier ones' amount.
function modlock.onDamage(handler: (hit: DamageEvent) -> DamageResult?)
	table.insert(damages, handler)
end

-- onChat calls handler with each chat line a player writes, commands
-- included, on the next server frame.
function modlock.onChat(handler: (line: ChatEvent) -> ())
	table.insert(chats, handler)
end

-- onDamaged calls handler on the frame after each hit lands.
function modlock.onDamaged(handler: (hit: DamagedEvent) -> ())
	table.insert(damageds, handler)
end

-- onLaunch calls handler with each watched projectile's first frame, before
-- the next frame. watchProjectiles names the projectiles.
function modlock.onLaunch(handler: (projectile: LaunchEvent) -> ())
	table.insert(launches, handler)
end

-- onImpact calls handler when a watched projectile strikes something, inside
-- the game's impact: its calls apply before the game continues.
function modlock.onImpact(handler: (impact: ImpactEvent) -> ())
	table.insert(impacts, handler)
end

-- onLanded calls handler when a hero lands under the manifest's QuakeWorld
-- movement, before the next frame.
function modlock.onLanded(handler: (landing: LandedEvent) -> ())
	table.insert(landeds, handler)
end

-- onSettingChanged calls handler when a player's setting changes outside the
-- mod, such as on the player's profile. The mod's own player:setSetting calls
-- do not reach it.
function modlock.onSettingChanged(handler: (player: Player, key: string, value: string) -> ())
	table.insert(settingChanges, handler)
end

-- handlers delivers each event to the handlers the mod registered.
local handlers: ModHandlers = {
	start = function(event)
		for _, handler in starts do
			handler(event.args)
		end
		-- Timers run from frames, so the library always takes them.
		return { frames = true, damage = #damages ~= 0, damaged = #damageds ~= 0, chat = #chats ~= 0 }
	end,

	frame = function(event)
		advanceTimers(event.timeSeconds)
		for _, handler in frames do
			handler(event)
		end
	end,

	command = function(event)
		-- Split the command line into its name and arguments.
		local name, args = string.match(event.line, "^%s*(%S+)%s*(.-)%s*$")
		local handler = if name then commands[name] else nil
		if handler == nil then
			return { claimed = false }
		end

		-- Claim the command and run its handler with the next frame. The server
		-- reads a client's commands under a CPU budget and drops the client when
		-- one handler spends it; slow work in a frame only delays that frame.
		local player = event.player
		modlock.after(0, function()
			handler(player, args or "")
		end)
		return { claimed = true }
	end,

	-- A line arrives under the same CPU budget as a command, so its handlers
	-- run with the next frame.
	chat = function(event)
		modlock.after(0, function()
			for _, handler in chats do
				handler(event)
			end
		end)
	end,

	world = function(event)
		for _, handler in worlds do
			handler(event.map)
		end
	end,

	-- Luau mods build no interface yet, so no button reports a press and no
	-- input a change.
	uiPress = function(_event) end,
	uiInput = function(_event) end,

	serve = function(event)
		local handler = services[event.service]
		if handler == nil then
			error(`the mod serves no service {event.service}`, 0)
		end
		return { payload = handler(event.method, event.payload) }
	end,

	damage = function(event)
		-- Offer the hit to each handler in turn, with the amount the earlier
		-- ones set; a block ends the offer.
		local amount = event.amount
		for _, handler in damages do
			local hit = table.clone(event)
			hit.amount = amount
			local change = handler(hit)
			if change and change.block then
				return { block = true }
			end
			amount = if change and change.amount then change.amount else amount
		end

		-- Answer nothing when no handler changed the hit.
		return if amount == event.amount then {} else { amount = amount }
	end,

	damaged = function(event)
		for _, handler in damageds do
			handler(event)
		end
	end,

	input = function(event)
		for _, handler in inputs do
			handler(event.player, event.pressed, event.released)
		end
	end,

	restored = function(event)
		for _, handler in restoreds do
			handler(event.player, if event.error ~= "" then event.error else nil)
		end
	end,

	npcsRestored = function(event)
		for _, handler in npcsRestoreds do
			handler(if event.error ~= "" then event.error else nil)
		end
	end,

	launch = function(event)
		for _, handler in launches do
			handler(event)
		end
	end,

	impact = function(event)
		for _, handler in impacts do
			handler(event)
		end
	end,

	landed = function(event)
		for _, handler in landeds do
			handler(event)
		end
	end,

	settingChanged = function(event)
		for _, handler in settingChanges do
			handler(event.player, event.key, event.value)
		end
	end,

	playersChanged = function(event)
		roster = event.players
	end,
}

-- Answer each of the host's events with the handlers above.
host.handle(function(call: string): string
	return serveMod(handlers, call)
end)

return modlock
