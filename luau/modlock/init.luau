	-- position is the box's origin.
	position: Vector,
	-- facing is the box's rotation.
	facing: Angles?,
	-- mins is the box's lower corner, relative to position.
	mins: Vector,
	-- maxs is the box's upper corner, relative to position.
	maxs: Vector,
	-- strength is the fog's density.
	strength: number,
	-- color tints the fog as 0xRRGGBBAA; alpha is ignored.
	color: number,
}

-- RestoredEvent reports how a RestoreHero ended.
export type RestoredEvent = {
	-- player is the player whose hero was restored.
	player: Player,
	-- error describes why the hero does not match its target, or is empty when
	-- it held the target for a second.
	error: string,
}

-- PlayersChangedEvent holds every occupied player slot, as Players lists them.
export type PlayersChangedEvent = {
	players: { Connection },
}

-- Connection is one occupied player slot.
export type Connection = {
	-- player is the connection's server slot.
	player: Player,
	-- steamId identifies a human's account, or is zero for a bot.
	steamId: string,
	-- name is the player's name.
	name: string,
	-- bot is true for a bot player.
	bot: boolean,
	-- ready is true once a human has finished joining; bots are always ready.
	ready: boolean,
	-- generation changes each time a new connection takes the slot.
	generation: number,
	-- roles are what the player is to the running mods, as the program that
	-- runs the host grants them. A role decides what a mod shows, such as an
	-- unfinished feature for its testers; the platform that keeps a mod's
	-- shared data checks its own writers.
	roles: { ModRole },
}

-- Pawn is one player's hero this frame.
export type Pawn = {
	-- entity is the hero's entity handle, which ReadField reads.
	entity: number,
	-- hero identifies the hero, as SelectHero returns it.
	hero: number,
	-- team is the hero's team number.
	team: number,
	-- health is the hero's health; zero or less is dead.
	health: number,
	-- maxHealth is the hero's networked maximum health.
	maxHealth: number,
	-- position is the hero's origin, at its feet.
	position: Vector,
	-- eyeAngles is where the hero aims.
	eyeAngles: Angles,
	-- cameraAngles is where the player's camera looks.
	cameraAngles: Angles,
	-- stamina is the hero's stamina, absent until it has spawned fully.
	stamina: number?,
	-- maxStamina is the hero's maximum stamina, present with stamina.
	maxStamina: number?,
	-- generation is the connection generation the hero belongs to.
	generation: number,
	-- souls is the souls the player holds.
	souls: number,
	-- eyePosition is where the hero's view starts, for aiming traces.
	eyePosition: Vector,
	-- velocity is the hero's motion in units per second.
	velocity: Vector,
	-- carryingUrn is whether the hero carries the soul urn, absent when the
	-- game's modifier states cannot be read.
	carryingUrn: boolean?,
	-- score is the player's scoreboard, absent when the game's scoreboard
	-- cannot be read.
	score: Score?,
	-- cameraPosition is where the player's camera was in their latest command,
	-- shoulder offset included; a ray from it along camera_angles passes
	-- through the reticle. Absent for a bot and on hosts that cannot read
	-- commands.
	cameraPosition: Vector?,
}

-- Score is one player's scoreboard counters since the match began, as the
-- game counts them.
export type Score = {
	kills: number,
	deaths: number,
	assists: number,
	-- lastHits counts enemy troopers and neutrals the player finished.
	lastHits: number,
	-- denies counts allied troopers the player finished before an enemy could.
	denies: number,
	-- heroDamage is the damage the player dealt to enemy heroes.
	heroDamage: number,
	-- heroHealing is the healing the player gave other heroes.
	heroHealing: number,
	-- netWorth is the souls the player has earned, spent or not.
	netWorth: number,
}

-- CameraValue is a value for a camera param: a number for every param but
-- the target, which takes a position.
export type CameraValue = number | Vector

-- CameraMotion is how an operation moves its param.
export type CameraMotion = { hold: CameraHold } | { approach: CameraApproach } | { spring: CameraSpring } | { lerp: CameraLerp } | { lag: CameraLag }

-- CameraHold keeps a param where it is.
export type CameraHold = {
	-- duration is how long it holds, in seconds.
	duration: number?,
}

-- CameraApproach moves a param toward a value.
export type CameraApproach = {
	-- value is the value it approaches.
	value: CameraValue?,
	-- speed is the most the param moves each second; omitted, 600.
	speed: number?,
	-- defaultSpeed is the speed of the return to the usual value; omitted, 600.
	defaultSpeed: number?,
	-- acceleration is how fast the speed builds each second; omitted, 1000.
	acceleration: number?,
	-- minDuration is the least time it runs, in seconds.
	minDuration: number?,
	-- chaseDefault approaches the param's usual value instead of value.
	chaseDefault: boolean?,
}

-- CameraSpring pulls a param toward a value.
export type CameraSpring = {
	-- value is the value the spring pulls toward.
	value: CameraValue?,
	-- strength is the spring's strength; omitted, 10.
	strength: number?,
	-- minSpeed is the least the param moves each second.
	minSpeed: number?,
	-- maxDuration ends the spring after this many seconds, or never when zero.
	maxDuration: number?,
}

-- CameraLerp moves a param from one value to another over a time.
export type CameraLerp = {
	-- start is the value it starts from.
	start: CameraValue,
	-- end is the value it ends at.
	["end"]: CameraValue,
	-- bias and gain shape the curve between them.
	bias: number?,
	gain: number?,
	-- duration is the time it takes, in seconds; omitted, 1.
	duration: number?,
}

-- CameraLag lets a param trail its usual value.
export type CameraLag = {
	-- minDuration is the least time it runs, in seconds.
	minDuration: number?,
	-- lagTime is how far behind the param trails, in seconds.
	lagTime: number?,
	-- maxSpeed is the most the param moves each second.
	maxSpeed: number?,
	-- springStrength is the strength of the pull back to the usual value.
	springStrength: number?,
	-- keepTargetOnScreen strengthens the pull when the target would leave the
	-- screen; omitted, true.
	keepTargetOnScreen: boolean?,
}

-- CameraOptions adds one operation to a player's camera.
export type CameraOptions = {
	-- context names a group of operations, which ClearCamera removes together.
	-- Operations on one param in one context run in order, each after the one
	-- before it ends, so a mod sends a whole sequence at once.
	context: string?,
	-- param is the camera value the operation moves.
	param: CameraParam,
	-- motion is how it moves. Each motion ends once it reaches its value or
	-- its duration, and the param returns to its usual value unless another
	-- operation follows.
	motion: CameraMotion,
	-- delay starts the operation after this many seconds.
	delay: number?,
	-- relative adds the operation's values to the param's usual value instead
	-- of replacing it.
	relative: boolean?,
	-- priority decides between contexts moving one param: a higher operation
	-- takes over from a running lower one, which resumes when it ends, and a
	-- lower one does not show while a higher one runs. Omitted, 1.
	priority: number?,
	-- shared lets operations of other contexts move the param at the same time.
	shared: boolean?,
	-- target is the entity handle of the hero whose camera moves, as
	-- Pawn.entity reports it; omitted, the player's own hero.
	target: number?,
}

-- HeroTarget is the state RestoreHero gives one hero. Omitted parts keep the
-- hero's own.
export type HeroTarget = {
	-- position is the hero's origin.
	position: Vector,
	-- facing is where the camera faces; a bot's hero faces it.
	facing: Angles,
	-- fresh gives full health and stamina and readies every ability, in place
	-- of health, max health, upgrade bonuses and timers. A bot's ability
	-- upgrades may grow while the restore runs.
	fresh: boolean?,
	-- level sets the hero's level.
	level: number?,
	-- health and maxHealth set the hero's health and its base maximum. Both
	-- are required unless the target is fresh.
	health: number?,
	maxHealth: number?,
	-- upgradeBonuses are the three stat bonuses purchases add, as replays
	-- record them.
	upgradeBonuses: { number }?,
	-- abilities sets the hero's abilities in their slots.
	abilities: { EquipmentTarget }?,
	-- items lists the items that replace the hero's when replaceItems is set.
	items: { EquipmentTarget }?,
	-- replaceItems replaces every item the hero owns with items; an empty list
	-- removes them.
	replaceItems: boolean?,
	-- timers sets the charges and cooldowns of owned abilities and items.
	timers: { TimerTarget }?,
}

-- EquipmentTarget is one ability or item a HeroTarget gives the hero.
export type EquipmentTarget = {
	-- id identifies the definition, as Ability.id.
	id: number,
	-- slot is its place on the hero, as Ability.slot; abilities need one, and
	-- an item without one goes where the game puts it.
	slot: number?,
	-- state is the packed upgrade word, as Ability.state.
	state: number,
}

-- TimerTarget sets one owned ability's or item's charges and cooldowns.
-- Times are seconds from the moment the host writes them; an omitted start
-- and end mean no timer.
export type TimerTarget = {
	-- id identifies the ability, as Ability.id.
	id: number,
	-- charges is the charges it holds.
	charges: number,
	-- cooldownStart and cooldownEnd bound its cooldown.
	cooldownStart: number?,
	cooldownEnd: number?,
	-- rechargeStart and rechargeEnd bound the recovery of its next charge.
	rechargeStart: number?,
	rechargeEnd: number?,
}

-- BotOptions describes a bot player.
export type BotOptions = {
	-- name is the bot's player name.
	name: string,
	-- team is the team number to join: 2 or 3.
	team: number,
	-- hero names the bot's hero, such as hero_wraith, or gives its identifier
	-- as Pawn.hero reports it.
	hero: (string | number)?,
	-- position is where the bot appears.
	position: Vector?,
}

-- SettingChangedEvent is one player's new value of one setting.
export type SettingChangedEvent = {
	-- player is the player's server slot.
	player: Player,
	-- key names the setting.
	key: string,
	-- value is the new value.
	value: string,
}

-- UiPressEvent reports a press on a button in a player's interface.
export type UiPressEvent = {
	-- player is the player who pressed.
	player: Player,
	-- node is the id of the pressed button.
	node: string,
}

-- UiInputEvent reports a change the player made to an input in their
-- interface, with the value as the host checked it.
export type UiInputEvent = {
	-- player is the player who changed it.
	player: Player,
	-- node is the id of the input.
	node: string,
	-- value is the input's new value, in the kind its control holds.
	value: (string | number | boolean)?,
}

-- StartEvent describes the server the mod starts in.
export type StartEvent = {
	-- args holds the arguments that follow -- on the host command line.
	args: { string },
	-- checkOnly is true when the host checks the mod without starting a game.
	-- The mod then hears no game events, and a call that needs the game fails;
	-- logging, the host's services, settings, metrics, files, interfaces and
	-- the reload hold still answer.
	checkOnly: boolean,
	-- source holds an interpreted mod's entry, which the interpreter module
	-- evaluates during start. It is empty for a compiled mod.
	source: string,
}

-- StartResult declares which events the mod consumes.
export type StartResult = {
	-- frames asks for a Frame event every server frame.
	frames: boolean,
	-- damage asks for a damage event before each hit.
	damage: boolean,
	-- damaged asks for a damaged event after each hit.
	damaged: boolean,
	-- chat asks for a chat event for each chat line.
	chat: boolean,
}

-- FrameEvent identifies one server frame.
export type FrameEvent = {
	-- tick is the server tick, or zero when the clock is unavailable.
	tick: number,
	-- timeSeconds is the game clock at this frame, in seconds.
	timeSeconds: number,
	-- movement holds one sample per watched, live hero when this frame starts a
	-- new tick, and is empty otherwise.
	movement: { MovementSample },
}

-- CommandEvent carries one command line from a player: a chat line that
-- starts with a slash (or ".", "+" or "-"), without that prefix, or a console
-- command the server received.
export type CommandEvent = {
	-- player is the player who typed the command.
	player: Player,
	-- line is the complete command line, starting with the command name.
	line: string,
}

-- ChatEvent carries one chat line as the server accepted it, commands
-- included.
export type ChatEvent = {
	-- player is the player who wrote the line.
	player: Player,
	-- text is the line as written.
	text: string,
	-- all is true for chat every player reads, false for team chat.
	all: boolean,
	-- lane is the CMsgLaneColor of the lane the line pings: 1 yellow, 3
	-- green, 4 blue, 6 purple, or 0 for none.
	lane: number,
}

-- CommandResult answers whether the mod handled a command.
export type CommandResult = {
	-- claimed ends the command's dispatch; the game and later mods do not see
	-- it.
	claimed: boolean,
}

-- WorldEvent announces a loaded world.
export type WorldEvent = {
	-- map names the world's map.
	map: string,
}

-- ServiceCall calls one method of a service outside Modlock. A host that
-- embeds Modlock provides services of its own, such as a game mode's match,
-- and a mod may serve one to the host. The service and its caller agree on
-- the payload's encoding.
export type ServiceCall = {
	-- service names the service, such as "arena.match".
	service: string,
	-- method names the method within the service.
	method: string,
	-- payload is the call's argument.
	payload: string,
}

-- ServiceReply is a service's answer.
export type ServiceReply = {
	-- payload is the answer.
	payload: string,
}

-- PrecacheOptions names what the next world loads ahead of use.
export type PrecacheOptions = {
	-- heroes are hero names, such as hero_wraith.
	heroes: { string }?,
	-- resources are model and particle paths, such as models/props/crate.vmdl,
	-- with {addon} for the mod's content addon, as in models/{addon}/pawn.vmdl.
	resources: { string }?,
}

-- Player addresses one connected player by their server slot.
export type Player = {
	-- slot identifies the player on the server.
	slot: number,
	-- chat sends a server chat line to the player.
	chat: (self: Player, text: string) -> boolean,
	-- centerText shows text in the middle of the player's screen until it is
	-- replaced. Empty text clears it.
	centerText: (self: Player, text: string) -> boolean,
	-- announce shows a game announcement with a title to the player.
	announce: (self: Player, title: string, text: string) -> boolean,
	-- pawn returns the player's hero this frame, or nothing without one.
	pawn: (self: Player) -> Pawn?,
	-- setting returns the player's value of a setting the manifest
	-- declares: the value they chose, or the setting's default. A bot has the
	-- defaults.
	setting: (self: Player, key: string) -> string?,
	-- setSetting changes the player's value of a setting the manifest
	-- declares. The value follows the player to later games and other mods'
	-- servers of the same mod; a bot keeps the defaults.
	setSetting: (self: Player, key: string, value: string) -> boolean,
	-- addMetric adds to the player's total of a metric the manifest declares.
	-- The host keeps each player's totals in memory and hands them on once,
	-- when the player leaves or the mod stops; a bot keeps none.
	addMetric: (self: Player, name: string, value: number, label: string?) -> boolean,
	-- handoff replaces the handoff state for the player, such as the
	-- panels their HUD shows. It lasts only through a reload of the mod in the
	-- same game, in memory, as the game's does, and ends early when the player
	-- leaves; only that player reads it back, and a bot keeps none.
	handoff: (self: Player, text: string) -> boolean,
	-- handedOff returns the player's handoff state, or empty.
	handedOff: (self: Player) -> string?,
	-- selectHero gives the player a hero on a team, 2 or 3, and returns the
	-- hero's identifier as Pawn.hero reports it. The hero appears on a later
	-- frame.
	selectHero: (self: Player, hero: (string | number), team: number) -> number?,
	-- spectate moves the player to the spectators, without a hero. The player
	-- watches until a hero selection seats them again.
	spectate: (self: Player) -> boolean,
	-- watch points the player's camera at a hero, through the hero's own view
	-- or chasing it, as the game's spectator camera follows it. A spectator watches through
	-- their spectator camera, once it exists. A player with a hero watches
	-- while the hero stays where it stands, keeping its level, souls and items,
	-- until Unwatch returns them to it.
	watch: (self: Player, target: number, chase: boolean?) -> boolean,
	-- freeCamera lets the player fly their camera from a position, with the
	-- movement keys and the mouse, as the game's roaming spectator camera does.
	-- A player with a hero leaves it where it stands, as Watch does, until
	-- Unwatch returns them to it; Watch follows a hero again.
	freeCamera: (self: Player, position: Vector, facing: Angles) -> boolean,
	-- moveCamera adds one operation to the player's camera, as the game's
	-- abilities pull it back, widen its view or swing it to a point. Operations
	-- run alongside the game's own until they end or ClearCamera removes them.
	moveCamera: (self: Player, options: CameraOptions) -> boolean,
	-- clearCamera removes a context's camera operations from the player's
	-- camera, or every operation, and the camera returns to its usual place.
	clearCamera: (self: Player, context: string?) -> boolean,
	-- unwatch returns a player watching or flying the free camera from their
	-- hero back to it. Stopping the mod returns every such player.
	unwatch: (self: Player) -> boolean,
	-- respawn revives the player's dead hero.
	respawn: (self: Player) -> boolean,
	-- changeTeam moves the player's hero, living or dead, to team 2 or 3 where
	-- it stands, for a human or a bot alike. The hero keeps its hero,
	-- abilities, items and health, and the player keeps their connection; a
	-- dead hero respawns on its new team, on its timer or through Respawn. A
	-- living hero moved inside the other team's base dies to the base's
	-- defense. A player without a hero joins a team through SelectHero
	-- instead.
	changeTeam: (self: Player, team: number) -> boolean,
	-- clearItems removes every item the player's hero owns.
	clearItems: (self: Player) -> boolean,
	-- freeze holds the player's hero in place, without input or damage, until
	-- it is released. Stopping the mod releases it.
	freeze: (self: Player, frozen: boolean?) -> boolean,
	-- restoreStamina refills the player's stamina.
	restoreStamina: (self: Player) -> boolean,
	-- setStamina sets the player's stamina, as Pawn.stamina reads it. The game
	-- regenerates it as usual afterwards.
	setStamina: (self: Player, stamina: number) -> boolean,
	-- refreshAbility ends the cooldown of the hero's ability named ability,
	-- such as citadel_ability_melee_parry.
	refreshAbility: (self: Player, ability: string) -> boolean,
	-- abilities lists the abilities of the player's hero in the hero's order,
	-- or none without a live hero.
	abilities: (self: Player) -> { Ability },
	-- setAbility changes the upgrades, charges or timers of one of the hero's
	-- abilities. An omitted option stays as it is.
	setAbility: (self: Player, options: AbilityOptions) -> boolean,
	-- giveItem gives the hero an item, enabled and free. A hero that owns it
	-- keeps its one copy.
	giveItem: (self: Player, item: string) -> boolean,
	-- replaceAbility puts the ability named ability, untrained, in the hero's
	-- ability slot index, as Ability.slot, removing the ability there. An
	-- ability from another hero loads its models and particles only if
	-- Precache named that hero and those resources before the world loaded;
	-- otherwise its first effect stalls the game on a blocking load and the
	-- game reports an assertion.
	replaceAbility: (self: Player, index: number, ability: string) -> boolean,
	-- holdModifier keeps an ability's modifier, named "<ability>/<modifier>",
	-- on the hero with no expiry, giving it back whenever the game removes it
	-- or the hero returns. The hero must own the ability or item. Every hero
	-- that gains the modifier from the same ability keeps it until the hold
	-- ends. Releasing leaves the hero's current modifier until it dies.
	holdModifier: (self: Player, modifier: string, active: boolean?) -> boolean,
	-- giveModifier gives the hero an ability's modifier, named
	-- "<ability>/<modifier>", for seconds, as if the hero's own ability applied
	-- it; a hero without that ability applies it with its first ability. The
	-- game may end it sooner, as invisibility ends on a shot.
	giveModifier: (self: Player, modifier: string, seconds: number) -> boolean,
	-- teleport moves the player's hero and turns it and the camera. With a
	-- velocity it also sets the hero's motion, as a launch, and the camera
	-- follows the hero.
	teleport: (self: Player, position: Vector, facing: Angles, velocity: Vector?) -> boolean,
	-- move carries the player's hero to a position as continuous motion,
	-- as a recording plays back. Unlike Teleport it keeps the hero's animated
	-- model drawn when repeated every tick, and leaves the camera alone.
	move: (self: Player, position: Vector, facing: Angles, velocity: Vector?) -> boolean,
	-- steer replays a recorded movement command on the player's hero, usually a
	-- bot: the game runs the command's buttons and axes, so the hero crouches,
	-- slides, jumps and mantles with its own animation, and the step then ends
	-- on the recorded pose. The steering stays until the next Steer replaces
	-- it, its presses and its pose counting once: on the ticks between, the
	-- game's own movement carries the held command on from the pose. A Steer
	-- without one releases the hero.
	steer: (self: Player, steering: Steering?) -> boolean,
	-- drive gives a bot the controls a player has, where it looks, the
	-- movement axes and the buttons, as its input on every tick until the next
	-- Drive replaces it. The game runs that input as a player's own, so the
	-- hero accelerates, turns, jumps, dashes, slides and casts with its own
	-- movement and animation; the bot's own brain no longer moves it. Presses
	-- count once. A Drive without a command returns the bot to its brain.
	drive: (self: Player, command: DriveCommand?) -> boolean,
	-- adjustSouls gives the player delta souls, or takes them when delta is
	-- negative. A spend larger than the player's souls fails and spends
	-- nothing. Silent skips the pickup's sound and number.
	adjustSouls: (self: Player, delta: number, silent: boolean?) -> boolean,
	-- startingSouls sets the souls the player's hero spawns with.
	startingSouls: (self: Player, souls: number) -> boolean,
	-- resetHero rebuilds the player's hero as it first spawned, without items,
	-- ability upgrades, levels or ability points, holding souls.
	resetHero: (self: Player, souls: number) -> boolean,
	-- heal restores health to the player's hero, up to its maximum.
	heal: (self: Player, amount: number) -> boolean,
	-- sound plays a game sound event, such as Damage.Send.Crit, on the
	-- player's hero.
	sound: (self: Player, sound: string) -> boolean,
	-- restoreHero gives the player's live hero target over the next few
	-- seconds: the build first, then health, stamina and pose once it settles,
	-- then charges and cooldowns. A Restored event reports when the result has
	-- held for a second, or why it could not. A new call replaces the running
	-- one.
	restoreHero: (self: Player, target: HeroTarget) -> boolean,
	-- screenEffect plays a full-screen effect on the player's view. Effects of
	-- one kind stack. The player's hero must be alive.
	screenEffect: (self: Player, effect: ScreenEffect, timing: ScreenTiming?) -> boolean,
	-- clearScreenEffect ends every running instance of effect on the player's
	-- view.
	clearScreenEffect: (self: Player, effect: ScreenEffect) -> boolean,
	-- removeBot removes a bot the mod added.
	removeBot: (self: Player) -> boolean,
	-- blockInput withholds buttons from the player's hero until called
	-- again, on top of the block on everyone. Zero releases the player.
	blockInput: (self: Player, buttons: number) -> boolean,
	-- press presses buttons at the player's next input, even through a block.
	-- A bot presses them as a player would.
	press: (self: Player, buttons: number) -> boolean,
	-- kill kills a player's hero, crediting no one.
	kill: (self: Player) -> boolean,
	-- setVelocity replaces the motion of a player's hero without moving it.
	setVelocity: (self: Player, velocity: Vector) -> boolean,
	-- buttons returns the buttons a player holds, as Buttons bits, while the
	-- player is alive or dead.
	buttons: (self: Player) -> number?,
	-- watchMovement adds a player's hero to the movement samples of each Frame
	-- event on a new tick, or removes it.
	watchMovement: (self: Player, watch: boolean) -> boolean,
}
local Player = {}
Player.__index = Player

-- new returns the Player with slot.
function Player.new(slot: number): Player
	return setmetatable({ slot = slot }, Player) :: any
end

-- chat sends a server chat line to the player.
function Player.chat(self: Player, text: string): boolean
	return call("Chat", "ChatRequest", { player = self, text = text }) ~= nil
end

-- centerText shows text in the middle of the player's screen until it is
-- replaced. Empty text clears it.
function Player.centerText(self: Player, text: string): boolean
	return call("CenterText", "CenterTextRequest", { player = self, text = text }) ~= nil
end

-- announce shows a game announcement with a title to the player.
function Player.announce(self: Player, title: string, text: string): boolean
	return call("Announce", "AnnounceRequest", { player = self, title = title, text = text }) ~= nil
end

-- pawn returns the player's hero this frame, or nothing without one.
function Player.pawn(self: Player): Pawn?
	local response = call("Pawn", "PlayerRequest", { player = self }, "PawnResponse")
	if response == nil then
		return nil
	end
	return response.pawn
end

-- setting returns the player's value of a setting the manifest
-- declares: the value they chose, or the setting's default. A bot has the
-- defaults.
function Player.setting(self: Player, key: string): string?
	local response = call("PlayerSetting", "PlayerSettingRequest", { player = self, key = key }, "SettingResponse")
	if response == nil then
		return nil
	end
	return response.value
end

-- setSetting changes the player's value of a setting the manifest
-- declares. The value follows the player to later games and other mods'
-- servers of the same mod; a bot keeps the defaults.
function Player.setSetting(self: Player, key: string, value: string): boolean
	return call("SetPlayerSetting", "SetPlayerSettingRequest", { player = self, key = key, value = value }) ~= nil
end

-- addMetric adds to the player's total of a metric the manifest declares.
-- The host keeps each player's totals in memory and hands them on once,
-- when the player leaves or the mod stops; a bot keeps none.
function Player.addMetric(self: Player, name: string, value: number, label: string?): boolean
	return call("AddMetric", "AddMetricRequest", { player = self, name = name, value = value, label = label }) ~= nil
end

-- handoff replaces the handoff state for the player, such as the
-- panels their HUD shows. It lasts only through a reload of the mod in the
-- same game, in memory, as the game's does, and ends early when the player
-- leaves; only that player reads it back, and a bot keeps none.
function Player.handoff(self: Player, text: string): boolean
	return call("PlayerHandoff", "HandoffPlayerRequest", { player = self, text = text }) ~= nil
end

-- handedOff returns the player's handoff state, or empty.
function Player.handedOff(self: Player): string?
	local response = call("PlayerHandedOff", "PlayerRequest", { player = self }, "HandedOffResponse")
	if response == nil then
		return nil
	end
	return response.text
end

-- selectHero gives the player a hero on a team, 2 or 3, and returns the
-- hero's identifier as Pawn.hero reports it. The hero appears on a later
-- frame.
function Player.selectHero(self: Player, hero: (string | number), team: number): number?
	local response = call("SelectHero", "SelectHeroRequest", { player = self, hero = hero, team = team }, "HeroResponse")
	if response == nil then
		return nil
	end
	return response.hero
end

-- spectate moves the player to the spectators, without a hero. The player
-- watches until a hero selection seats them again.
function Player.spectate(self: Player): boolean
	return call("Spectate", "PlayerRequest", { player = self }) ~= nil
end

-- watch points the player's camera at a hero, through the hero's own view
-- or chasing it, as the game's spectator camera follows it. A spectator watches through
-- their spectator camera, once it exists. A player with a hero watches
-- while the hero stays where it stands, keeping its level, souls and items,
-- until Unwatch returns them to it.
function Player.watch(self: Player, target: number, chase: boolean?): boolean
	return call("Watch", "WatchRequest", { player = self, target = target, chase = chase }) ~= nil
end

-- freeCamera lets the player fly their camera from a position, with the
-- movement keys and the mouse, as the game's roaming spectator camera does.
-- A player with a hero leaves it where it stands, as Watch does, until
-- Unwatch returns them to it; Watch follows a hero again.
function Player.freeCamera(self: Player, position: Vector, facing: Angles): boolean
	return call("FreeCamera", "FreeCameraRequest", { player = self, position = position, facing = facing }) ~= nil
end

-- moveCamera adds one operation to the player's camera, as the game's
-- abilities pull it back, widen its view or swing it to a point. Operations
-- run alongside the game's own until they end or ClearCamera removes them.
function Player.moveCamera(self: Player, options: CameraOptions): boolean
	return call("MoveCamera", "CameraOptions", with(options, "player", self)) ~= nil
end

-- clearCamera removes a context's camera operations from the player's
-- camera, or every operation, and the camera returns to its usual place.
function Player.clearCamera(self: Player, context: string?): boolean
	return call("ClearCamera", "ClearCameraRequest", { player = self, context = context }) ~= nil
end

-- unwatch returns a player watching or flying the free camera from their
-- hero back to it. Stopping the mod returns every such player.
function Player.unwatch(self: Player): boolean
	return call("Unwatch", "PlayerRequest", { player = self }) ~= nil
end

-- respawn revives the player's dead hero.
function Player.respawn(self: Player): boolean
	return call("Respawn", "PlayerRequest", { player = self }) ~= nil
end

-- changeTeam moves the player's hero, living or dead, to team 2 or 3 where
-- it stands, for a human or a bot alike. The hero keeps its hero,
-- abilities, items and health, and the player keeps their connection; a
-- dead hero respawns on its new team, on its timer or through Respawn. A
-- living hero moved inside the other team's base dies to the base's
-- defense. A player without a hero joins a team through SelectHero
-- instead.
function Player.changeTeam(self: Player, team: number): boolean
	return call("ChangeTeam", "ChangeTeamRequest", { player = self, team = team }) ~= nil
end

-- clearItems removes every item the player's hero owns.
function Player.clearItems(self: Player): boolean
	return call("ClearItems", "PlayerRequest", { player = self }) ~= nil
end

-- freeze holds the player's hero in place, without input or damage, until
-- it is released. Stopping the mod releases it.
function Player.freeze(self: Player, frozen: boolean?): boolean
	return call("Freeze", "FreezeRequest", { player = self, frozen = frozen }) ~= nil
end

-- restoreStamina refills the player's stamina.
function Player.restoreStamina(self: Player): boolean
	return call("RestoreStamina", "PlayerRequest", { player = self }) ~= nil
end

-- setStamina sets the player's stamina, as Pawn.stamina reads it. The game
-- regenerates it as usual afterwards.
function Player.setStamina(self: Player, stamina: number): boolean
	return call("SetStamina", "SetStaminaRequest", { player = self, stamina = stamina }) ~= nil
end

-- refreshAbility ends the cooldown of the hero's ability named ability,
-- such as citadel_ability_melee_parry.
function Player.refreshAbility(self: Player, ability: string): boolean
	return call("RefreshAbility", "RefreshAbilityRequest", { player = self, ability = ability }) ~= nil
end

-- abilities lists the abilities of the player's hero in the hero's order,
-- or none without a live hero.
function Player.abilities(self: Player): { Ability }
	local response = call("Abilities", "PlayerRequest", { player = self }, "AbilitiesResponse")
	if response == nil then
		return {}
	end
	return response.abilities
end

-- setAbility changes the upgrades, charges or timers of one of the hero's
-- abilities. An omitted option stays as it is.
function Player.setAbility(self: Player, options: AbilityOptions): boolean
	return call("SetAbility", "AbilityOptions", with(options, "player", self)) ~= nil
end

-- giveItem gives the hero an item, enabled and free. A hero that owns it
-- keeps its one copy.
function Player.giveItem(self: Player, item: string): boolean
	return call("GiveItem", "GiveItemRequest", { player = self, item = item }) ~= nil
end

-- replaceAbility puts the ability named ability, untrained, in the hero's
-- ability slot index, as Ability.slot, removing the ability there. An
-- ability from another hero loads its models and particles only if
-- Precache named that hero and those resources before the world loaded;
-- otherwise its first effect stalls the game on a blocking load and the
-- game reports an assertion.
function Player.replaceAbility(self: Player, index: number, ability: string): boolean
	return call("ReplaceAbility", "ReplaceAbilityRequest", { player = self, index = index, ability = ability }) ~= nil
end

-- holdModifier keeps an ability's modifier, named "<ability>/<modifier>",
-- on the hero with no expiry, giving it back whenever the game removes it
-- or the hero returns. The hero must own the ability or item. Every hero
-- that gains the modifier from the same ability keeps it until the hold
-- ends. Releasing leaves the hero's current modifier until it dies.
function Player.holdModifier(self: Player, modifier: string, active: boolean?): boolean
	return call("HoldModifier", "HoldModifierRequest", { player = self, modifier = modifier, active = active }) ~= nil
end

-- giveModifier gives the hero an ability's modifier, named
-- "<ability>/<modifier>", for seconds, as if the hero's own ability applied
-- it; a hero without that ability applies it with its first ability. The
-- game may end it sooner, as invisibility ends on a shot.
function Player.giveModifier(self: Player, modifier: string, seconds: number): boolean
	return call("GiveModifier", "GiveModifierRequest", { player = self, modifier = modifier, seconds = seconds }) ~= nil
end

-- teleport moves the player's hero and turns it and the camera. With a
-- velocity it also sets the hero's motion, as a launch, and the camera
-- follows the hero.
function Player.teleport(self: Player, position: Vector, facing: Angles, velocity: Vector?): boolean
	return call("Teleport", "TeleportRequest", { player = self, position = position, facing = facing, velocity = velocity }) ~= nil
end

-- move carries the player's hero to a position as continuous motion,
-- as a recording plays back. Unlike Teleport it keeps the hero's animated
-- model drawn when repeated every tick, and leaves the camera alone.
function Player.move(self: Player, position: Vector, facing: Angles, velocity: Vector?): boolean
	return call("MovePlayer", "MovePlayerRequest", { player = self, position = position, facing = facing, velocity = velocity }) ~= nil
end

-- steer replays a recorded movement command on the player's hero, usually a
-- bot: the game runs the command's buttons and axes, so the hero crouches,
-- slides, jumps and mantles with its own animation, and the step then ends
-- on the recorded pose. The steering stays until the next Steer replaces
-- it, its presses and its pose counting once: on the ticks between, the
-- game's own movement carries the held command on from the pose. A Steer
-- without one releases the hero.
function Player.steer(self: Player, steering: Steering?): boolean
	return call("Steer", "SteerRequest", { player = self, steering = steering }) ~= nil
end

-- drive gives a bot the controls a player has, where it looks, the
-- movement axes and the buttons, as its input on every tick until the next
-- Drive replaces it. The game runs that input as a player's own, so the
-- hero accelerates, turns, jumps, dashes, slides and casts with its own
-- movement and animation; the bot's own brain no longer moves it. Presses
-- count once. A Drive without a command returns the bot to its brain.
function Player.drive(self: Player, command: DriveCommand?): boolean
	return call("Drive", "DriveRequest", { player = self, command = command }) ~= nil
end

-- adjustSouls gives the player delta souls, or takes them when delta is
-- negative. A spend larger than the player's souls fails and spends
-- nothing. Silent skips the pickup's sound and number.
function Player.adjustSouls(self: Player, delta: number, silent: boolean?): boolean
	return call("AdjustSouls", "AdjustSoulsRequest", { player = self, delta = delta, silent = silent }) ~= nil
end

-- startingSouls sets the souls the player's hero spawns with.
function Player.startingSouls(self: Player, souls: number): boolean
	return call("StartingSouls", "StartingSoulsRequest", { player = self, souls = souls }) ~= nil
end

-- resetHero rebuilds the player's hero as it first spawned, without items,
-- ability upgrades, levels or ability points, holding souls.
function Player.resetHero(self: Player, souls: number): boolean
	return call("ResetHero", "ResetHeroRequest", { player = self, souls = souls }) ~= nil
end

-- heal restores health to the player's hero, up to its maximum.
function Player.heal(self: Player, amount: number): boolean
	return call("Heal", "HealRequest", { player = self, amount = amount }) ~= nil
end

-- sound plays a game sound event, such as Damage.Send.Crit, on the
-- player's hero.
function Player.sound(self: Player, sound: string): boolean
	return call("Sound", "SoundRequest", { player = self, sound = sound }) ~= nil
end

-- restoreHero gives the player's live hero target over the next few
-- seconds: the build first, then health, stamina and pose once it settles,
-- then charges and cooldowns. A Restored event reports when the result has
-- held for a second, or why it could not. A new call replaces the running
-- one.
function Player.restoreHero(self: Player, target: HeroTarget): boolean
	return call("RestoreHero", "RestoreHeroRequest", { player = self, target = target }) ~= nil
end

-- screenEffect plays a full-screen effect on the player's view. Effects of
-- one kind stack. The player's hero must be alive.
function Player.screenEffect(self: Player, effect: ScreenEffect, timing: ScreenTiming?): boolean
	return call("ScreenEffect", "ScreenEffectRequest", { player = self, effect = effect, timing = timing }) ~= nil
end

-- clearScreenEffect ends every running instance of effect on the player's
-- view.
function Player.clearScreenEffect(self: Player, effect: ScreenEffect): boolean
	return call("ClearScreenEffect", "ClearScreenEffectRequest", { player = self, effect = effect }) ~= nil
end

-- removeBot removes a bot the mod added.
function Player.removeBot(self: Player): boolean
	return call("RemoveBot", "PlayerRequest", { player = self }) ~= nil
end

-- blockInput withholds buttons from the player's hero until called
-- again, on top of the block on everyone. Zero releases the player.
function Player.blockInput(self: Player, buttons: number): boolean
	return call("BlockPlayerInput", "PlayerInputRequest", { player = self, buttons = buttons }) ~= nil
end

-- press presses buttons at the player's next input, even through a block.
-- A bot presses them as a player would.
function Player.press(self: Player, buttons: number): boolean
	return call("Press", "PlayerInputRequest", { player = self, buttons = buttons }) ~= nil
end

-- kill kills a player's hero, crediting no one.
function Player.kill(self: Player): boolean
	return call("Kill", "PlayerRequest", { player = self }) ~= nil
end

-- setVelocity replaces the motion of a player's hero without moving it.
function Player.setVelocity(self: Player, velocity: Vector): boolean
	return call("SetVelocity", "SetVelocityRequest", { player = self, velocity = velocity }) ~= nil
end

-- buttons returns the buttons a player holds, as Buttons bits, while the
-- player is alive or dead.
function Player.buttons(self: Player): number?
	local response = call("Buttons", "PlayerRequest", { player = self }, "ButtonsResponse")
	if response == nil then
		return nil
	end
	return response.buttons
end

-- watchMovement adds a player's hero to the movement samples of each Frame
-- event on a new tick, or removes it.
function Player.watchMovement(self: Player, watch: boolean): boolean
	return call("WatchMovement", "WatchMovementRequest", { player = self, watch = watch }) ~= nil
end

modlock.Player = Player

-- WorldObject is one object the mod placed in the world.
export type WorldObject = {
	-- id identifies the object among the mod's objects.
	id: number,
	-- move places the object at position, turning it to facing. The
	-- physics step pulls a solid model to its new place over one tick, so a
	-- model moved each frame strikes physics props such as the Hideout ball
	-- with its speed instead of passing through them.
	move: (self: WorldObject, position: Vector, facing: Angles?) -> boolean,
	-- setText replaces a text object's words.
	setText: (self: WorldObject, text: string) -> boolean,
	-- setHidden hides the object from one player or shows it again.
	-- Other players still see it. A player who leaves sees every object when
	-- they return.
	setHidden: (self: WorldObject, player: Player, hidden: boolean) -> boolean,
	-- showOnlyTo sends the object only to the players with the listed
	-- server slots; every other client drops it, or never receives it when the
	-- call follows its creation in the same frame. With no players no client
	-- receives it. The list replaces any earlier one and follows the object
	-- when its entity changes. A player who leaves is taken off every list, so
	-- whoever joins in their slot does not receive the object. A removed object
	-- reaches no client while the engine retires its entity.
	showOnlyTo: (self: WorldObject, players: { number }?) -> boolean,
	-- showToAll sends the object to every player again, undoing
	-- ShowObjectOnlyTo.
	showToAll: (self: WorldObject) -> boolean,
	-- remove takes the object out of the world.
	remove: (self: WorldObject) -> boolean,
	-- entity returns the entity handle of a model or particle, as traces
	-- report it and particle anchors take it.
	entity: (self: WorldObject) -> number?,
}
local WorldObject = {}
WorldObject.__index = WorldObject

-- new returns the WorldObject with id.
function WorldObject.new(id: number): WorldObject
	return setmetatable({ id = id }, WorldObject) :: any
end

-- move places the object at position, turning it to facing. The
-- physics step pulls a solid model to its new place over one tick, so a
-- model moved each frame strikes physics props such as the Hideout ball
-- with its speed instead of passing through them.
function WorldObject.move(self: WorldObject, position: Vector, facing: Angles?): boolean
	return call("MoveObject", "MoveObjectRequest", { object = self, position = position, facing = facing }) ~= nil
end

-- setText replaces a text object's words.
function WorldObject.setText(self: WorldObject, text: string): boolean
	return call("SetText", "SetTextRequest", { object = self, text = text }) ~= nil
end

-- setHidden hides the object from one player or shows it again.
-- Other players still see it. A player who leaves sees every object when
-- they return.
function WorldObject.setHidden(self: WorldObject, player: Player, hidden: boolean): boolean
	return call("SetObjectHidden", "SetObjectHiddenRequest", { object = self, player = player, hidden = hidden }) ~= nil
end

-- showOnlyTo sends the object only to the players with the listed
-- server slots; every other client drops it, or never receives it when the
-- call follows its creation in the same frame. With no players no client
-- receives it. The list replaces any earlier one and follows the object
-- when its entity changes. A player who leaves is taken off every list, so
-- whoever joins in their slot does not receive the object. A removed object
-- reaches no client while the engine retires its entity.
function WorldObject.showOnlyTo(self: WorldObject, players: { number }?): boolean
	return call("ShowObjectOnlyTo", "ShowObjectOnlyToRequest", { object = self, players = players }) ~= nil
end

-- showToAll sends the object to every player again, undoing
-- ShowObjectOnlyTo.
function WorldObject.showToAll(self: WorldObject): boolean
	return call("ShowObjectToAll", "ObjectRequest", { object = self }) ~= nil
end

-- remove takes the object out of the world.
function WorldObject.remove(self: WorldObject): boolean
	return call("RemoveObject", "ObjectRequest", { object = self }) ~= nil
end

-- entity returns the entity handle of a model or particle, as traces
-- report it and particle anchors take it.
function WorldObject.entity(self: WorldObject): number?
	local response = call("ObjectEntity", "ObjectRequest", { object = self }, "EntityResponse")
	if response == nil then
		return nil
	end
	return response.entity
end

modlock.WorldObject = WorldObject

-- Npc is one unit the mod spawned.
export type Npc = {
	-- entity is the unit's entity handle, as damage events report it.
	entity: number,
	-- read returns the unit's state, or nothing once it is gone.
	read: (self: Npc) -> NpcState?,
	-- move places the unit and sets its velocity, which drives its walk
	-- animation. It reports false once the unit is gone.
	move: (self: Npc, position: Vector, facing: Angles?, velocity: Vector?) -> boolean,
	-- setHealth sets the unit's health, and its maximum when given. It
	-- reports false once the unit is gone.
	setHealth: (self: Npc, health: number, maxHealth: number?) -> boolean,
	-- remove takes a unit the mod spawned out of the world without rewards.
	-- It reports false when the unit was already gone.
	remove: (self: Npc) -> boolean,
}
local Npc = {}
Npc.__index = Npc

-- new returns the Npc with entity.
function Npc.new(entity: number): Npc
	return setmetatable({ entity = entity }, Npc) :: any
end

-- read returns the unit's state, or nothing once it is gone.
function Npc.read(self: Npc): NpcState?
	local response = call("ReadNpc", "NpcRequest", { npc = self }, "NpcStateResponse")
	if response == nil then
		return nil
	end
	return response.state
end

-- move places the unit and sets its velocity, which drives its walk
-- animation. It reports false once the unit is gone.
function Npc.move(self: Npc, position: Vector, facing: Angles?, velocity: Vector?): boolean
	local response = call("MoveNpc", "MoveNpcRequest", { npc = self, position = position, facing = facing, velocity = velocity }, "AliveResponse")
	if response == nil then
		return false
	end
	return response.alive
end

-- setHealth sets the unit's health, and its maximum when given. It
-- reports false once the unit is gone.
function Npc.setHealth(self: Npc, health: number, maxHealth: number?): boolean
	local response = call("SetNpcHealth", "SetNpcHealthRequest", { npc = self, health = health, maxHealth = maxHealth }, "AliveResponse")
	if response == nil then
		return false
	end
	return response.alive
end

-- remove takes a unit the mod spawned out of the world without rewards.
-- It reports false when the unit was already gone.
function Npc.remove(self: Npc): boolean
	local response = call("RemoveNpc", "NpcRequest", { npc = self }, "AliveResponse")
	if response == nil then
		return false
	end
	return response.alive
end

modlock.Npc = Npc

-- Pickup is one pickup the mod placed.
