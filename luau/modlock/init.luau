-- call calls one Host method with its request and returns the decoded
-- response, true when the method answers nothing, or nil when the call
-- failed; the host logs why.
local function call(method: string, requestType: string, request: any, responseType: string?): any
	local encoded = wire.encode(schema, "Call", {
		method = method,
		request = wire.encode(schema, requestType, request),
	})
	local reply = wire.decode(schema, "Reply", host.hostCall(encoded))
	if reply.error ~= "" then
		return nil
	end
	if responseType == nil then
		return true
	end
	return wire.decode(schema, responseType, reply.response)
end

-- with returns a copy of options that holds value under name.
local function with(options: any, name: string, value: any): any
	local request = table.clone(options)
	request[name] = value
	return request
end

