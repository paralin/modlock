export type CommandName = CommandName0 | CommandName1 | CommandName2

-- set sets the console variable name to value. It returns false when the
-- host refuses.
local function set(name: string, value: boolean | number | string): boolean
	local text = if type(value) == "boolean"
		then (if value then "1" else "0")
		elseif type(value) == "string" then `"{value}"`
		else tostring(value)
	return modlock.serverCommand(`{name} {text}`)
end

-- setBoolean sets the boolean console variable name to value.
function console.setBoolean(name: BooleanVariable, value: boolean): boolean
	return set(name, value)
end

-- setNumber sets the numeric console variable name to value.
function console.setNumber(name: NumberVariable, value: number): boolean
	return set(name, value)
end

-- setString sets the string console variable name to value.
function console.setString(name: StringVariable, value: string): boolean
	return set(name, value)
end

-- run runs the console command name with args, each one word of the line.
function console.run(name: CommandName, ...: string): boolean
	return modlock.serverCommand(table.concat({ name, ... }, " "))
end

return console
