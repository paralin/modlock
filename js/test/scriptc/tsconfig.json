{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "paths": {
      "bun:test": ["./testing.ts"],
      "modlock": ["../../src/index.ts"],
      "modlock/jsx-runtime": ["../../src/index.ts"],
      "modlock/*": ["../../src/*"]
    }
  },
  "include": [
    "*.ts",
    "../*.test.ts",
    "../../src/globals.d.ts",
    "../../src/scriptc.ts"
  ],
  "exclude": ["build", "node_modules"]
}
