{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../.tmp/js-types",
    "rootDir": "..",
    "paths": {
      "modlock": ["./src/index.ts"]
    }
  },
  "files": [
    "src/globals.d.ts",
    "src/index.ts",
    "src/ui.ts",
    "src/heroes.ts",
    "src/hud.ts",
    "src/theme.ts",
    "src/entities.ts",
    "src/console.ts",
    "src/spot.ts",
    "src/kit/index.ts",
    "src/quickjs.ts",
    "src/scriptc.ts"
  ],
  "include": ["src/kit/*.ts"]
}
