{
  "name": "modlock",
  "private": true,
  "aptre": {
    "tsTypedDecode": true,
    "tsTypedEncode": true
  },
  "scripts": {
    "gen": "./scripts/gen-proto.sh --language ts",
    "prepare": "sh scripts/install-hooks.sh",
    "typecheck": "tsrs --noEmit -p js/tsconfig.json && tsrs --noEmit -p js/test/tsconfig.json && tsrs --noEmit -p panorama/tsconfig.json && tsrs --noEmit -p panorama/browser/tsconfig.json && tsrs --noEmit -p scripts/tsconfig.json && tsrs --noEmit -p cmd/modlock-npm/tsconfig.json && tsrs --noEmit -p studio/web/tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run check:tla",
    "check:tla": "aptre-tla .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:cc": "bun scripts/lint-cc.ts",
    "format": "oxfmt",
    "format:cc": "git ls-files -z '*.cc' '*.h' ':!:third_party' ':!:*.pb.*' | xargs -0 clang-format -i",
    "test": "bun test --timeout 30000 ./panorama/ ./js/test/"
  },
  "devDependencies": {
    "@aptre/common": "0.37.0",
    "@aptre/protobuf-es-lite": "1.2.6",
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "type": "module"
}
