{
  "name": "modlock",
  "private": true,
  "aptre": {
    "tsTypedDecode": true,
    "tsTypedEncode": true
  },
  "scripts": {
    "gen": "./scripts/gen-proto.sh --language ts",
    "prepare": "sh scripts/install-hooks.sh",
    "typecheck": "tsrs --noEmit -p js/tsconfig.json && tsrs --noEmit -p js/test/tsconfig.json && tsrs --noEmit -p panorama/tsconfig.json && tsrs --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:cc": "bun scripts/lint-cc.ts",
    "format": "oxfmt",
    "format:cc": "git ls-files -z '*.cc' '*.h' ':!:third_party' ':!:*.pb.*' | xargs -0 clang-format -i",
    "test": "bun test --timeout 30000 ./panorama/ ./js/test/"
  },
  "devDependencies": {
    "@aptre/protobuf-es-lite": "1.2.4",
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@types/bun": "1.3.14",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "type": "module"
}
